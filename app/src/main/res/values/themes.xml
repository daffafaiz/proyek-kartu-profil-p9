<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Selalu terang: tidak ikut dark mode HP, supaya teks isian dan hint
         tetap terbaca di atas latar terang. -->
    <style name="Theme.BelajarMobile" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@color/primary</item>
    </style>
</resources>
