<?xml version="1.0" encoding="utf-8"?>
<!-- VERSI AKHIR Pertemuan 7 — pengembangan layar kedua Pertemuan 6:
     kini ada lencana inisial (tvInisial, dihitung dari nama) dan baris
     umur + kategori hasil olahan MainActivity (tvUmurDiterima). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- BARU di Pertemuan 7: lencana inisial, dihitung dari nama -->
    <TextView
        android:id="@+id/tvInisial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:textColor="@color/primary"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/judul_tentang"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNamaDiterima"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEmailDiterima"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="16sp" />

    <!-- BARU di Pertemuan 7: umur + kategori hasil perhitungan -->
    <TextView
        android:id="@+id/tvUmurDiterima"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvDeskripsi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/deskripsi_profil"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnKembali"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/tombol_kembali" />
</LinearLayout>
