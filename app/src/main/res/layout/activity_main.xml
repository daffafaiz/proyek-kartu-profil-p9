<?xml version="1.0" encoding="utf-8"?>
<!-- VERSI AKHIR Pertemuan 7 — sama dengan versi akhir Pertemuan 6,
     ditambah SATU kolom baru: etTahunLahir di bawah etEmail
     (bahan validasi & perhitungan umur, Modul Praktikum Pertemuan 7). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivFoto"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/desc_foto"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" />

        <TextView
            android:id="@+id/tvJudul"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="@string/judul_profil"
            android:textColor="@color/primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubjudul"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="@string/subjudul_profil"
            android:textColor="@color/text_muted"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etNama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/hint_nama"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress" />

        <!-- BARU di Pertemuan 7: kolom tahun lahir (angka saja) -->
        <EditText
            android:id="@+id/etTahunLahir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_tahun_lahir"
            android:inputType="number"
            android:maxLength="4"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBatal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/tombol_batal" />

            <Button
                android:id="@+id/btnSimpan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tombol_simpan"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/primary" />
        </LinearLayout>

        <!-- BARU di Pertemuan 9: hapus data tersimpan (SharedPreferences) -->
        <Button
            android:id="@+id/btnHapusSimpan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tombol_hapus_data" />

        <!-- BARU di Pertemuan 10: data dari internet (REST API) -->
        <Button
            android:id="@+id/btnLihatPengguna"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tombol_lihat_pengguna" />

        <Button
            android:id="@+id/btnLihatKutipan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tombol_lihat_kutipan" />

        <!-- BARU di Pertemuan 6: teks status / umpan balik di layar -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
