<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pertemuan 10: tanpa izin ini Android melarang akses jaringan.
         Letaknya di luar tag <application>. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BelajarMobile">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pertemuan 6: layar kedua hanya dibuka dari dalam aplikasi
             lewat Intent, jadi exported="false". -->
        <activity
            android:name=".SecondActivity"
            android:exported="false" />

        <!-- Pertemuan 10: daftar pengguna (JSONPlaceholder) dan daftar
             kutipan (API pilihan sendiri). -->
        <activity android:name=".UserListActivity" />
        <activity android:name=".QuoteListActivity" />

    </application>

</manifest>
